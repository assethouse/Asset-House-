<style>
  .ah-hero-section {
    position: relative;
    width: 100%;
    min-height: 500px;
    background-color: #111111;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .ah-hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.45;
    z-index: 1;
  }

  .ah-hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4);
    z-index: 2;
  }

  .ah-hero-container {
    position: relative;
    z-index: 3;
    max-width: 950px;
    width: 90%;
    text-align: center;
    padding: 70px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Slider Track */
  .ah-slider-track {
    width: 100%;
    position: relative;
    min-height: 240px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ah-slide {
    width: 100%;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s ease-in-out, visibility 0.6s ease-in-out;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ah-slide.active {
    opacity: 1;
    visibility: visible;
    position: relative;
    transform: none;
    top: auto;
    left: auto;
  }

  /* Subtitle text above heading */
  .ah-slide-sub {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 14px;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.15);
    padding: 6px 14px;
    border-radius: 4px;
  }

  /* Ultra-Bold Heading */
  .ah-slide-title {
    font-size: clamp(36px, 6vw, 64px) !important;
    font-weight: 900 !important;
    line-height: 1.08 !important;
    text-transform: uppercase !important;
    letter-spacing: -0.02em !important;
    color: #ffffff !important;
    margin: 0 0 28px 0 !important;
    text-shadow: 0 2px 12px rgba(0,0,0,0.4);
  }

  /* Exact Button Replication */
  .ah-hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #ffffff !important;
    color: #000000 !important;
    font-size: 13px !important;
    font-weight: 800 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.1em !important;
    padding: 14px 34px !important;
    border-radius: 4px !important;
    text-decoration: none !important;
    border: none !important;
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .ah-hero-btn:hover {
    background-color: #f0f0f0 !important;
    transform: translateY(-2px);
  }

  /* Slider Dots Navigation */
  .ah-dots {
    display: flex;
    gap: 10px;
    margin-top: 35px;
    z-index: 10;
  }

  .ah-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.4);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.3s, transform 0.3s;
  }

  .ah-dot.active {
    background-color: #ffffff;
    transform: scale(1.25);
  }
</style>

<div class="ah-hero-section">
  {%- if section.settings.bg_image != blank -%}
    <img src="{{ section.settings.bg_image | image_url: width: 2000 }}" alt="Hero Background" class="ah-hero-bg">
  {%- else -%}
    <img src="https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-image_large.png" alt="Background Placeholder" class="ah-hero-bg">
  {%- endif -%}
  <div class="ah-hero-overlay"></div>

  <div class="ah-hero-container">
    <div class="ah-slider-track" id="ahSliderTrack">
      {%- for block in section.blocks -%}
        <div class="ah-slide {% if forloop.first %}active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.subtitle != blank -%}
            <div class="ah-slide-sub">{{ block.settings.subtitle }}</div>
          {%- endif -%}
          <h1 class="ah-slide-title">{{ block.settings.title }}</h1>
          {%- if block.settings.button_text != blank -%}
            <a href="{{ block.settings.button_link }}" class="ah-hero-btn">{{ block.settings.button_text }}</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <!-- Dots -->
    <div class="ah-dots" id="ahDots">
      {%- for block in section.blocks -%}
        <button class="ah-dot {% if forloop.first %}active{% endif %}" onclick="currentSlide({{ forloop.index0 }})"></button>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function() {
    let slideIndex = 0;
    const slides = document.querySelectorAll('.ah-slide');
    const dots = document.querySelectorAll('.ah-dot');
    let slideInterval;

    function showSlide(n) {
      if (slides.length === 0) return;
      slides.forEach((slide, index) => {
        slide.classList.remove('active');
        if (dots[index]) dots[index].classList.remove('active');
      });
      slideIndex = (n + slides.length) % slides.length;
      slides[slideIndex].classList.add('active');
      if (dots[slideIndex]) dots[slideIndex].classList.add('active');
    }

    function nextSlide() {
      showSlide(slideIndex + 1);
    }

    window.currentSlide = function(n) {
      showSlide(n);
      resetTimer();
    }

    function resetTimer() {
      clearInterval(slideInterval);
      slideInterval = setInterval(nextSlide, 5000);
    }

    if (slides.length > 1) {
      slideInterval = setInterval(nextSlide, 5000);
    }
  })();
</script>

{% schema %}
{
  "name": "Asset House Hero Slideshow",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Hero Slide",
      "settings": [
        {
          "type": "text",
          "id": "subtitle",
          "label": "Small Top Tagline",
          "default": "PREMIUM DIGITAL ASSETS"
        },
        {
          "type": "textarea",
          "id": "title",
          "label": "Heading Text",
          "default": "THE UK'S LEADING DIGITAL BUSINESS HOUSE"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "SHOP ALL"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Asset House Hero Slideshow",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "subtitle": "PREMIUM DIGITAL ASSETS",
            "title": "THE UK'S LEADING DIGITAL BUSINESS HOUSE",
            "button_text": "SHOP ALL"
          }
        },
        {
          "type": "slide",
          "settings": {
            "subtitle": "INSTANT DOWNLOAD ACCESS",
            "title": "250,000+ ENTREPRENEURS TRUST OUR TEMPLATES!",
            "button_text": "SHOP BUNDLES"
          }
        },
        {
          "type": "slide",
          "settings": {
            "subtitle": "SCALABLE BLUEPRINTS",
            "title": "THE ULTIMATE BUSINESS STARTER TOOLKITS",
            "button_text": "EXPLORE GUIDES"
          }
        }
      ]
    }
  ]
}
{% endschema %}
