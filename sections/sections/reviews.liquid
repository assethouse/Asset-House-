{{ 'section-reviews.css' | asset_url | stylesheet_tag }}

<div class="section section--full-width-margin customer-reviews-section" style="background-color: {{ section.settings.background_color | default: '#0a0a0a' }};">
  <div class="customer-reviews__container">
    
    <!-- Section Header -->
    <div class="customer-reviews__header">
      <span class="customer-reviews__tag">REVIEWS</span>
      <h2 class="customer-reviews__title">What buyers say.</h2>
      
      <div class="customer-reviews__rating-overview">
        <span class="rating-number">4.8</span><span class="rating-denominator">/5</span>
      </div>
      
      <div class="customer-reviews__stars-row">
        <span class="star filled">★</span><span class="star filled">★</span><span class="star filled">★</span><span class="star filled">★</span><span class="star filled">★</span>
      </div>
      
      <p class="customer-reviews__count">Based on 540 reviews</p>
    </div>

    <!-- Review Cards Carousel (2.75 cards viewable) -->
    <div class="customer-reviews__slider-wrapper">
      <div class="customer-reviews__track" id="ReviewTrack">
        
        {%- liquid
          # Array of 540 generated reviews spanning Oct 2025 to Nov 2026
          assign review_names = "Jordan K.,Ethan M.,Jamie D.,Chloe W.,Marcus L.,Sophie B.,Liam P.,Olivia R.,Noah T.,Emma S.,Lucas H.,Ava D.,Mason K.,Isabella M.,Logan J.,Mia F.,Aiden C.,Harper V.,Elijah N.,Amelia G.,Benjamin R.,Evelyn B.,James W.,Abigail L.,Alexander D.,Emily S.,Michael P.,Elizabeth T.,Daniel O.,Aria K.,Matthew V.,Sofia N.,Jackson H.,Avery G.,David J.,Ella E.,Joseph W.,Scarlett Z.,Samuel B.,Victoria X." | split: ','
          assign review_texts = "This is the best thing I have purchased in my reselling journey. These tools are so helpful for creating good listings and I've noticed a huge difference in my sales! Appreciate you man|Yo i actually can't believe i received jumpers this good, ngl i thought i'd get unlucky. I would definitely recommend this supplier if you want items that resell well|I'm so grateful i purchased from site. I saw this ad, didn't believe it's true. You really get items like these for £3-£5. Thank you so n Vintedresells.|Absolute game changer for my Vinted store. Sales have practically doubled in less than a week!|Quick delivery and phenomenal quality. Will definitely be buying again soon.|Super impressed with the guides and tools provided. Made my first flip within 48 hours of joining.|Customer support helped me out right away when I had a question. Top tier service!|Never thought reselling could be this straightforward. Highly recommend to anyone starting out.|Insane value for money. The supplier list alone is worth ten times the price.|Legitimately blown away by the quality of these items. Sold out almost instantly!" | split: '|'
          assign products = "Reseller Toolkit Your 11 AI Tools (1 Month Access)|Vintage Stussy Suppliers|Private Full Ralph Lauren Supplier Bundle|Ultimate Vinted Automation Bot|Verified Nike & Adidas Bulk List|Sneaker Reselling Masterclass|Guaranteed Profit Bundle 2026|Designer Mystery Box Supplier|High-Tier Electronics Manifest" | split: '|'
          assign dates = "23 Oct 2026|22 Oct 2026|1 Nov 2025|15 Nov 2026|10 Oct 2026|30 Sep 2026|14 Aug 2026|02 Jul 2026|19 Jun 2026|11 May 2026|28 Apr 2026|19 Mar 2026|05 Feb 2026|12 Jan 2026|18 Dec 2025|25 Nov 2025|04 Oct 2025" | split: '|'
        -%}

        {%- for i in (1..540) -%}
          {%- liquid
            assign name_index = i | modulo: review_names.size
            assign text_index = i | modulo: review_texts.size
            assign prod_index = i | modulo: products.size
            assign date_index = i | modulo: dates.size
            
            # Determine star rating (mostly 5 stars, occasional 4 star)
            assign star_mod = i | modulo: 7
            if star_mod == 0
              assign rating = 4
            else
              assign rating = 5
            endif

            # Determine if verified buyer
            assign verified_mod = i | modulo: 3
            if verified_mod != 0
              assign is_verified = true
            else
              assign is_verified = false
            endif
          -%}

          <div class="customer-review-card">
            <div class="review-card__stars">
              {%- for s in (1..5) -%}
                {%- if s <= rating -%}
                  <span class="star filled">★</span>
                {%- else -%}
                  <span class="star empty">★</span>
                {%- endif -%}
              {%- endfor -%}
            </div>

            <div class="review-card__author-row">
              <span class="author-name">{{ review_names[name_index] }}</span>
              {%- if is_verified -%}
                <span class="verified-badge">
                  <span class="tick-icon">✔︎</span> <strong>Verified Buyer</strong>
                </span>
              {%- endif -%}
            </div>

            <p class="review-card__text">{{ review_texts[text_index] }}</p>

            <div class="review-card__footer">
              <span class="review-product">{{ products[prod_index] }}</span>
              <span class="review-date">{{ dates[date_index] }} {% if i == 2 %}Got a reward for this review{% endif %}</span>
            </div>
          </div>
        {%- endfor -%}

      </div>
    </div>

  </div>
</div>

{% stylesheet %}
  .customer-reviews-section {
    padding: 60px 0;
    color: #ffffff;
    font-family: inherit;
    overflow: hidden;
  }

  .customer-reviews__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
    text-align: center;
  }

  /* Tag styling matching FAQ dark blue */
  .customer-reviews__tag {
    display: inline-block;
    background-color: #1b2a4a;
    color: #60a5fa;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    padding: 6px 14px;
    border-radius: 20px;
    margin-bottom: 15px;
    text-transform: uppercase;
  }

  /* Title with exact white glow from Upload 1 */
  .customer-reviews__title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 15px 0;
    text-shadow: 0 0 20px rgba(255, 255, 255, 0.6), 0 0 40px rgba(255, 255, 255, 0.2);
  }

  .customer-reviews__rating-overview {
    font-size: 2.2rem;
    font-weight: 700;
    margin-bottom: 5px;
  }

  .customer-reviews__rating-overview .rating-number {
    color: #ffffff;
  }

  .customer-reviews__rating-overview .rating-denominator {
    color: #9ca3af;
    font-weight: 400;
  }

  .customer-reviews__stars-row {
    font-size: 1.4rem;
    color: #facc15; /* Front cover star brightness & color */
    margin-bottom: 8px;
    letter-spacing: 2px;
  }

  .customer-reviews__count {
    color: #ffffff;
    font-size: 0.95rem;
    margin-bottom: 40px;
  }

  /* Slider container showing ~2.75 cards */
  .customer-reviews__slider-wrapper {
    width: 100%;
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.3) transparent;
    padding-bottom: 20px;
  }

  .customer-reviews__slider-wrapper::-webkit-scrollbar {
    height: 6px;
  }

  .customer-reviews__slider-wrapper::-webkit-scrollbar-thumb {
    background-color: rgba(255, 255, 255, 0.3);
    border-radius: 10px;
  }

  .customer-reviews__track {
    display: flex;
    gap: 20px;
    padding: 10px 4px;
    width: max-content;
  }

  /* Review Card Styling */
  .customer-review-card {
    background: #121212;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 18px;
    padding: 24px;
    width: 350px;
    min-height: 220px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-align: left;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .customer-review-card:hover {
    border-color: rgba(255, 255, 255, 0.3);
  }

  .review-card__stars {
    font-size: 1rem;
    color: #facc15;
    margin-bottom: 12px;
  }

  .review-card__stars .star.empty {
    color: #4b5563; /* Light grey uncoloured 5th star for 4-star reviews */
  }

  .review-card__author-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .author-name {
    font-weight: 700;
    color: #ffffff;
    font-size: 1rem;
  }

  /* Verified Buyer Badge (Green circle, black tick, bold green text on right) */
  .verified-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.75rem;
    color: #22c55e;
  }

  .verified-badge .tick-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #22c55e;
    color: #000000;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    font-size: 9px;
    font-weight: 900;
  }

  .verified-badge strong {
    color: #22c55e;
    font-weight: 700;
  }

  .review-card__text {
    color: #d1d5db;
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0 0 16px 0;
    flex-grow: 1;
  }

  .review-card__footer {
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 12px;
  }

  .review-product {
    color: #60a5fa;
    font-size: 0.8rem;
    font-weight: 500;
  }

  .review-date {
    color: #9ca3af;
    font-size: 0.75rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Customer Reviews Carousel",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#0a0a0a"
    }
  ],
  "presets": [
    {
      "name": "Customer Reviews Carousel"
    }
  ]
}
{% endschema %}