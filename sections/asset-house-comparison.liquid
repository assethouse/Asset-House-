<style>
  .ah-comparison-wrapper {
    background-color: #ffffff !important;
    color: #000000 !important;
    width: 100% !important;
    padding: 70px 4% !important;
    box-sizing: border-box;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  
  .ah-comparison-container {
    max-width: 1350px;
    margin: 0 auto;
    width: 100%;
  }

  .ah-comparison-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  @media screen and (max-width: 990px) {
    .ah-comparison-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  /* Left Side Styling */
  .ah-comparison-left h2 {
    font-size: clamp(34px, 4.8vw, 52px) !important;
    font-weight: 900 !important;
    line-height: 1.05 !important;
    text-transform: uppercase !important;
    letter-spacing: -0.03em !important;
    margin: 0 0 22px 0 !important;
    color: #000000 !important;
  }

  .ah-comparison-left p {
    font-size: 16px !important;
    line-height: 1.65 !important;
    color: #444444 !important;
    margin-bottom: 35px !important;
    font-weight: 400 !important;
    max-width: 540px;
  }

  .ah-bullet-list {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .ah-bullet-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    font-size: 16px;
    font-weight: 500;
    color: #111111;
    line-height: 1.4;
  }

  .ah-bullet-icon {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    border: 2px solid #222222;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
    color: #222222;
  }

  .ah-bullet-icon svg {
    width: 13px;
    height: 13px;
  }

  /* Right Side Table Styling (Exact Upload 1 Look & Feel) */
  .ah-table-container {
    width: 100%;
    border: 1px solid #d0d0d0;
    background-color: #ffffff;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.04);
  }

  .ah-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .ah-table th {
    padding: 22px 16px;
    font-weight: 700 !important;
    font-size: 15px;
    vertical-align: middle;
    border-bottom: 1px solid #d0d0d0;
    letter-spacing: -0.01em;
  }

  .ah-table th.th-feature {
    width: 42%;
    text-align: left;
    color: #333333;
    background-color: #fcfcfc;
    padding-left: 22px;
    border-right: 1px solid #d0d0d0;
  }

  .ah-table th.th-brand {
    width: 33%;
    background-color: #000000;
    color: #ffffff;
    text-align: center;
    font-weight: 600 !important;
    border-right: 1px solid rgba(255, 255, 255, 0.2);
  }

  .ah-table th.th-others {
    width: 25%;
    background-color: #f7f7f7;
    color: #555555;
    text-align: center;
  }

  .ah-table td {
    padding: 20px 16px;
    border-bottom: 1px solid #e2e2e2;
    vertical-align: middle;
    font-size: 14.5px;
  }

  .ah-table tr:last-child td {
    border-bottom: none;
  }

  .ah-table td.td-feature {
    font-weight: 500;
    color: #222222;
    padding-left: 22px;
    line-height: 1.4;
    border-right: 1px solid #e2e2e2;
    background-color: #fcfcfc;
  }

  .ah-table td.td-brand {
    background-color: #000000;
    color: #ffffff;
    text-align: center;
    border-right: 1px solid rgba(255, 255, 255, 0.15);
  }

  .ah-table td.td-others {
    background-color: #ffffff;
    color: #777777;
    text-align: center;
  }

  /* Status Icons */
  .mark-check {
    color: #2e7d32;
    font-size: 20px;
    font-weight: 800;
    display: inline-block;
  }

  .mark-cross {
    color: #d32f2f;
    font-size: 18px;
    font-weight: 800;
    display: inline-block;
  }
</style>

<div class="ah-comparison-wrapper">
  <div class="ah-comparison-container">
    <div class="ah-comparison-grid">
      
      <!-- Left Column -->
      <div class="ah-comparison-left">
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.subtext }}</p>
        
        <div class="ah-bullet-list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'bullet' -%}
              <div class="ah-bullet-item" {{ block.shopify_attributes }}>
                <div class="ah-bullet-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <span>{{ block.settings.text }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <!-- Right Column: Structured Table -->
      <div class="ah-table-container">
        <table class="ah-table">
          <thead>
            <tr>
              <th class="th-feature"></th>
              <th class="th-brand">{{ section.settings.brand_column_title }}</th>
              <th class="th-others">{{ section.settings.competitor_column_title }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              {%- if block.type == 'row' -%}
                <tr {{ block.shopify_attributes }}>
                  <td class="td-feature">{{ block.settings.feature_name }}</td>
                  <td class="td-brand">
                    {%- if block.settings.brand_status == 'check' -%}
                      <span class="mark-check">✓</span>
                    {%- else -%}
                      {{ block.settings.brand_value }}
                    {%- endif -%}
                  </td>
                  <td class="td-others">
                    {%- if block.settings.competitor_status == 'cross' -%}
                      <span class="mark-cross">✕</span>
                    {%- else -%}
                      {{ block.settings.competitor_value }}
                    {%- endif -%}
                  </td>
                </tr>
              {%- endif -%}
            {%- endfor -%}
          </tbody>
        </table>
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Asset House Comparison",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ASSET HOUSE VS OTHER PROVIDERS"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Description",
      "default": "Why thousands of ambitious business owners choose Asset House. Compare our professional quality, comprehensive digital templates, instant downloads, and commitment to practical execution that makes growing your enterprise seamless."
    },
    {
      "type": "text",
      "id": "brand_column_title",
      "label": "Brand Column Header",
      "default": "Asset House"
    },
    {
      "type": "text",
      "id": "competitor_column_title",
      "label": "Competitor Header",
      "default": "Others"
    }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Left Bullet Point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Bullet Text",
          "default": "Instant access to professionally designed business templates & toolkits."
        }
      ]
    },
    {
      "type": "row",
      "name": "Comparison Row",
      "settings": [
        {
          "type": "text",
          "id": "feature_name",
          "label": "Feature Name",
          "default": "Feature"
        },
        {
          "type": "select",
          "id": "brand_status",
          "label": "Asset House Icon Type",
          "options": [
            { "value": "check", "label": "Green Checkmark (✓)" },
            { "value": "text", "label": "Custom Text" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "brand_value",
          "label": "Asset House Custom Text",
          "default": "✓"
        },
        {
          "type": "select",
          "id": "competitor_status",
          "label": "Others Icon Type",
          "options": [
            { "value": "cross", "label": "Red Cross (✕)" },
            { "value": "text", "label": "Custom Text" }
          ],
          "default": "cross"
        },
        {
          "type": "text",
          "id": "competitor_value",
          "label": "Others Custom Text",
          "default": "✕"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Asset House Comparison",
      "blocks": [
        {
          "type": "bullet",
          "settings": { "text": "Instant secure digital file delivery immediately following checkout." }
        },
        {
          "type": "bullet",
          "settings": { "text": "Clean, fully editable spreadsheets, planners, and operational toolkits." }
        },
        {
          "type": "bullet",
          "settings": { "text": "Designed for immediate business execution with zero fluff or filler." }
        },
        {
          "type": "bullet",
          "settings": { "text": "Lifetime access and free updates with a single one-time payment." }
        },
        {
          "type": "row",
          "settings": { "feature_name": "Instant digital file access", "brand_status": "check", "competitor_status": "cross" }
        },
        {
          "type": "row",
          "settings": { "feature_name": "Fully customizable templates", "brand_status": "check", "competitor_status": "cross" }
        },
        {
          "type": "row",
          "settings": { "feature_name": "Zero fluff, high-utility tools", "brand_status": "check", "competitor_status": "cross" }
        },
        {
          "type": "row",
          "settings": { "feature_name": "Lifetime access & free updates", "brand_status": "check", "competitor_status": "cross" }
        },
        {
          "type": "row",
          "settings": { "feature_name": "Dedicated customer support", "brand_status": "check", "competitor_status": "cross" }
        },
        {
          "type": "row",
          "settings": { "feature_name": "Complete business starter bundles", "brand_status": "check", "competitor_status": "cross" }
        }
      ]
    }
  ]
}
{% endschema %}
