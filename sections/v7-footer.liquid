<section id="shopify-section-{{ section.id }}" class="vr-footer-section">
  <div class="vr-footer-container">
    
    <!-- Top Main Footer Grid -->
    <div class="vr-footer-grid">
      
      <!-- Column 1: Brand / Logo Info -->
      <div class="vr-footer-col vr-footer-brand-col">
        <div class="vr-footer-logo-wrap">
          <img src="https://cdn.shopify.com/s/files/1/1032/8109/9078/files/24F59A16-3CF9-420B-B649-5951A0F9670A.png?v=1794700883" alt="V7 Supply" class="vr-footer-logo">
        </div>
        <p class="vr-footer-slogan">Turning Everyday Resellers Into Six-Figure Earners.</p>
        
        <!-- Rating Row: Text to the left of stars -->
        <div class="vr-footer-rating-inline">
          <span class="vr-footer-rating-text">4.8 out of 5 from 540 buyer reviews</span>
          <div class="vr-footer-stars">
            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
          </div>
        </div>

        <a href="https://www.tiktok.com/@luckkyedit" target="_blank" rel="noopener" class="vr-footer-tiktok-link">
          <svg class="vr-tiktok-icon" viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="3.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg>
          <span class="vr-tiktok-username">@luckkyedit</span>
        </a>
      </div>

      <!-- Column 2: SHOP -->
      <div class="vr-footer-col">
        <h3 class="vr-footer-heading">SHOP</h3>
        <ul class="vr-footer-links">
          <li><a href="/pages/1000-guarantee">The £1,000 guarantee</a></li>
          <li><a href="/collections/all">All products</a></li>
          <li><a href="/pages/all-premium-suppliers">All premium suppliers</a></li>
          <li><a href="/products/full-starter-kit">Full starter kit</a></li>
          <li><a href="/products/full-reselling-guide">Full reselling guide</a></li>
        </ul>
      </div>

      <!-- Column 3: EXPLORE -->
      <div class="vr-footer-col">
        <h3 class="vr-footer-heading">EXPLORE</h3>
        <ul class="vr-footer-links">
          <li><a href="/pages/how-it-works">How it works</a></li>
          <li><a href="/pages/founders-journey">Founders journey</a></li>
        </ul>
      </div>

      <!-- Column 4: SUPPORT -->
      <div class="vr-footer-col">
        <h3 class="vr-footer-heading">SUPPORT</h3>
        <ul class="vr-footer-links">
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/pages/contact">Contact us</a></li>
          <li><a href="/pages/find-my-order">Find my order</a></li>
          <li><a href="mailto:support@v7supply.com">support@v7supply.com</a></li>
        </ul>
      </div>

      <!-- Column 5: LEGAL -->
      <div class="vr-footer-col">
        <h3 class="vr-footer-heading">LEGAL</h3>
        <ul class="vr-footer-links">
          <li><a href="/policies/privacy-policy">Privacy policy</a></li>
          <li><a href="/policies/terms-of-service">Terms of service</a></li>
          <li><a href="/policies/refund-policy">Refund policy</a></li>
          <li><a href="/policies/shipping-policy">Shipping policy</a></li>
          <li><a href="/policies/cookie-settings">Cookie settings</a></li>
        </ul>
      </div>

    </div>

    <!-- Middle Security & Payment Trust Bar -->
    <div class="vr-footer-trust-bar">
      <div class="vr-trust-left">
        <div class="vr-secure-checkout">
          <svg class="vr-lock-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#3b82f6" stroke-width="3"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          <span class="vr-secure-text">Secure checkout</span>
        </div>

        <div class="vr-guarantee-badge-wrap">
          <div class="vr-crest-badge">
            <svg class="vr-crest-shield" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#1b3a8b" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            <span class="vr-crest-check">✓</span>
          </div>
          <span class="vr-guarantee-text">Spend £50: We Guarantee you’ll earn £1000 in 30 days.</span>
        </div>
      </div>

      <div class="vr-trust-right">
        <div class="vr-payment-pill vr-pill-apple">Apple Pay</div>
        <div class="vr-payment-pill vr-pill-google">G Pay</div>
        <div class="vr-payment-pill vr-pill-visa">VISA</div>
        <div class="vr-payment-pill vr-pill-mastercard">
          <div class="mc-circles">
            <span class="mc-red"></span>
            <span class="mc-orange"></span>
          </div>
        </div>
        <div class="vr-payment-pill vr-pill-amex">AMEX</div>
      </div>
    </div>

    <!-- Bottom Disclaimers & Copyright -->
    <div class="vr-footer-disclaimer">
      <p>V7 Supply is an independent reselling education company. Our products are vetted supplier directories, reselling stock, training and community access. Any clothing shown on this site or in our content is genuine pre-owned or vintage stock sourced from established UK wholesale suppliers. All brand names and trademarks remain the property of their respective owners and no brand affiliation or endorsement is implied. Individual results vary and no level of income is guaranteed.</p>
      <p>V7 Supply is an independent brand operated by V7 Supply. All third-party names and marks are the property of their respective owners.</p>
      <p class="vr-copyright">© 2026 V7 Supply. All rights reserved.</p>
    </div>

  </div>
</section>

