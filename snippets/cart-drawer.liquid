{%- doc -%}
  Renders cart drawer
{%- enddoc -%}

<cart-drawer class="cart-drawer{% if cart == empty %} is-empty{% endif %}">
  <div 
    id="CartDrawer" 
    class="cart-drawer__overlay" 
    onclick="const drawer = this.closest('cart-drawer'); drawer.removeAttribute('open'); drawer.classList.remove('active'); document.body.classList.remove('cart-open');"
  ></div>
  <div
    id="CartDrawer-Drawer"
    class="cart-drawer__inner custom-pitch-black-cart"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'cart.general.title' | t }}"
  >
    {%- if cart == empty -%}
      <!-- Top Header Bar with "Your cart" and Bold X -->
      <div class="cart-drawer__top-bar">
        <h2 class="cart-drawer__heading">Your cart</h2>
        <button
          type="button"
          class="cart-drawer__close"
          aria-label="{{ 'accessibility.close' | t }}"
          onclick="const drawer = this.closest('cart-drawer'); drawer.removeAttribute('open'); drawer.classList.remove('active'); document.body.classList.remove('cart-open');"
        >
          <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" role="presentation" class="icon icon-close-bold" fill="none" viewBox="0 0 24 24">
            <path d="M4 4l16 16M20 4L4 20" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
      <div class="cart-drawer__header-divider"></div>

      <!-- Empty Cart Content -->
      <div class="cart-drawer__empty-content">
        <div class="cart__empty-text-wrapper">
          <h3 class="cart__empty-title">Your cart is empty</h3>
          <p class="cart__empty-subtitle">Add a supplier pack to get started.</p>
        </div>
        <a href="{{ routes.root_url }}pages/shop" class="button cart__empty-button">
          Start shopping
        </a>
      </div>
    {%- else -%}
      <!-- Populated Cart Header -->
      <div class="cart-drawer__top-bar">
        <h2 class="cart-drawer__heading">Your cart</h2>
        <button
          type="button"
          class="cart-drawer__close"
          aria-label="{{ 'accessibility.close' | t }}"
          onclick="const drawer = this.closest('cart-drawer'); drawer.removeAttribute('open'); drawer.classList.remove('active'); document.body.classList.remove('cart-open');"
        >
          <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" role="presentation" class="icon icon-close-bold" fill="none" viewBox="0 0 24 24">
            <path d="M4 4l16 16M20 4L4 20" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
      <div class="cart-drawer__header-divider"></div>
      
      <!-- Cart items rendering area -->
      <div class="cart-drawer__items-container">
        <!-- Cart items logic -->
      </div>
    {%- endif -%}
  </div>
</cart-drawer>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const cartTriggers = document.querySelectorAll('#cart-icon-bubble, a[href*="/cart"], .header__icon--cart, [data-cart-icon]');
    const cartDrawer = document.querySelector('cart-drawer');

    cartTriggers.forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        if (cartDrawer) {
          e.preventDefault();
          cartDrawer.setAttribute('open', '');
          cartDrawer.classList.add('active');
          document.body.classList.add('cart-open');
        }
      });
    });
  });
</script>

{% stylesheet %}
  /* Pitch Black Cart Drawer Container - Hidden by default */
  .cart-drawer__inner.custom-pitch-black-cart {
    background-color: #000000 !important;
    color: #ffffff !important;
    width: 78vw !important;
    max-width: 300px !important;
    position: fixed;
    height: 100dvh;
    top: 0;
    right: 0;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    padding: 0;
    box-shadow: -5px 0 25px rgba(0, 0, 0, 0.8);
    transform: translateX(100%);
    visibility: hidden;
    opacity: 0;
    transition: transform 0.3s ease, visibility 0.3s ease, opacity 0.3s ease;
  }

  /* Show when open attribute or active class is present */
  cart-drawer[open] .cart-drawer__inner.custom-pitch-black-cart,
  cart-drawer.active .cart-drawer__inner.custom-pitch-black-cart,
  .cart-open cart-drawer .cart-drawer__inner.custom-pitch-black-cart {
    transform: translateX(0) !important;
    visibility: visible !important;
    opacity: 1 !important;
  }

  /* Top Bar Layout */
  .cart-drawer__top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 20px 16px 20px;
  }

  /* Heading ("Your cart") matching menu header font & boldness */
  .cart-drawer__heading {
    color: #ffffff !important;
    font-size: 1.6rem !important;
    font-weight: 600 !important;
    letter-spacing: -0.01em;
    margin: 0;
    line-height: 1.2;
  }

  /* Bold, Thicker X Close Button */
  .cart-drawer__close {
    background: transparent;
    border: none;
    color: #ffffff;
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cart-drawer__close svg {
    width: 24px;
    height: 24px;
  }

  /* Faint White Divider Line */
  .cart-drawer__header-divider {
    width: 100%;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.12);
  }

  /* Empty Cart Content Positioning & Spacing */
  .cart-drawer__empty-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 40px 20px 0 20px;
  }

  .cart__empty-text-wrapper {
    margin-bottom: 20px;
  }

  /* "Your cart is empty" heading */
  .cart__empty-title {
    color: #ffffff !important;
    font-size: 1.6rem !important;
    font-weight: 600 !important;
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }

  /* "Add a supplier pack to get started." in light grey */
  .cart__empty-subtitle {
    color: rgba(255, 255, 255, 0.7) !important;
    font-size: 1.4rem !important;
    margin: 0;
    font-weight: 400;
  }

  /* "Start shopping" Rounded Blue Button */
  .cart__empty-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #0055ff !important;
    color: #ffffff !important;
    font-weight: 600 !important;
    font-size: 1.5rem !important;
    padding: 12px 32px !important;
    border-radius: 9999px !important;
    text-decoration: none !important;
    border: none !important;
    box-shadow: 0 4px 14px rgba(0, 85, 255, 0.4);
    transition: background-color 0.2s ease;
    width: 100%;
    max-width: 200px;
  }

  .cart__empty-button:hover {
    background-color: #0044cc !important;
    color: #ffffff !important;
  }

  /* Overlay */
  .cart-drawer__overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100dvh;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: brightness(0.75);
    z-index: 999;
    display: none;
  }

  cart-drawer[open] .cart-drawer__overlay,
  cart-drawer.active .cart-drawer__overlay,
  .cart-open cart-drawer .cart-drawer__overlay {
    display: block;
  }
{% endstylesheet %}
