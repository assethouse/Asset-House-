{%- doc -%}
  Renders a header drawer menu triggered by the top details element.

  @param {object} linklist - The linklist to render
  @param {string} [class] - Additional classes to add to the drawer
  @param {string} [data_header_drawer_type] - The type of header drawer to render
  @param {object} [block] - The block that can be used to provide settings
  @param {object} [section] - The section that can be used to provide settings

  @example
  {% render 'header-drawer', linklist: section.settings.menu, class: 'header-drawer--mobile' %}
{%- enddoc -%}

{% render 'summary-icon-styles' %}

{% liquid
  assign block_settings = block.settings
  assign eager_loading = false
  if section.index == blank
    assign eager_loading = true
  endif
%}

<script
  src="{{ 'header-drawer.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<header-drawer
  class="header-drawer {{ class }}"
>
  <details
    id="Details-menu-drawer-container"
    data-skip-node-update="true"
    class="menu-drawer-container"
    ref="details"
    scroll-lock
  >
    <summary
      class="header__icon header__icon--menu header__icon--summary"
      aria-label="{{ 'accessibility.menu' | t }}"
      on:click="/toggle"
    >
      <span class="svg-wrapper header-drawer-icon header-drawer-icon--open" style="display: inline-flex; align-items: center; justify-content: center;">
        <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" role="presentation" class="icon icon-hamburger" fill="none" viewBox="0 0 28 16" style="transform: scale(1.2); transform-origin: center;">
          <path d="M0 1h28M0 8h28M0 15h28" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
        </svg>
      </span>
      <span class="svg-wrapper header-drawer-icon header-drawer-icon--close" style="display: none !important;">
        {{- 'icon-close-menu.svg' | inline_asset_content -}}
      </span>
    </summary>
    <div
      ref="menuDrawer"
      class="menu-drawer custom-pitch-black-drawer"
    >
      <!-- Top Bar: V7 Supply Logo (Top Left) & Bold X Close Button (Top Right) -->
      <div class="menu-drawer__top-bar">
        <a href="{{ routes.root_url }}" class="menu-drawer__logo-link">
          <img src="https://cdn.shopify.com/s/files/1/1032/8109/9078/files/24F59A16-3CF9-420B-B649-5951A0F9670A_53cb2d80-0b9c-4764-89da-51e25b0fc515.png?v=1794711907" alt="{{ shop.name }}" class="menu-drawer__logo-img">
        </a>
        <button
          class="button button-unstyled close-button menu-drawer__close-button focus-inset"
          type="button"
          aria-label="{{ 'actions.close' | t }}"
          on:click="header-drawer/close"
        >
          <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" role="presentation" class="icon icon-close-bold" fill="none" viewBox="0 0 24 24">
            <path d="M4 4l16 16M20 4L4 20" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>

      <nav
        class="menu-drawer__navigation"
        aria-label="{{ 'accessibility.header_navigation_label' | t }}"
      >
        <ul
          class="menu-drawer__menu has-submenu"
          role="list"
        >
          {%- for link in linklist.links -%}
            <li class="menu-drawer__list-item menu-drawer__list-item--divider">
              <a
                id="HeaderDrawer-{{ link.handle }}"
                href="{{ link.url }}"
                class="menu-drawer__menu-item menu-drawer__menu-item--mainlist menu-drawer__animated-element"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                <span class="menu-drawer__menu-item-text wrap-text">{{ link.title | escape }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    </div>
    <div
      class="menu-drawer__backdrop"
      on:click="header-drawer/close"
    ></div>
  </details>
</header-drawer>

{% stylesheet %}
  .header__icon--menu {
    position: initial;
  }

  .menu-drawer-container .header__icon--summary {
    color: var(--color-foreground);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: var(--padding-lg);
  }

  .header__icon--summary .header-drawer-icon {
    margin: auto;
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  /* Permanently hide the close icon in the summary button so it never flashes */
  .header__icon--menu .header-drawer-icon--close {
    display: none !important;
  }

  details.menu-open .header__icon--menu .header-drawer-icon--open {
    display: flex;
  }

  /* Pitch Black Drawer & Narrow Width Styling */
  .menu-drawer.custom-pitch-black-drawer {
    background-color: #000000 !important;
    color: #ffffff !important;
    width: 78vw !important;
    max-width: 300px !important;
    position: fixed;
    transform: translateX(-100%);
    visibility: hidden;
    height: 100dvh;
    z-index: var(--layer-menu-drawer);
    inset-inline-start: 0;
    top: 0;
    padding: 0;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, visibility 0.25s ease, opacity 0.25s ease;
  }

  .menu-open > .menu-drawer.custom-pitch-black-drawer {
    transform: translateX(0);
    visibility: visible;
    opacity: 1;
  }

  /* Top Bar Layout */
  .menu-drawer__top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 20px 16px 20px;
  }

  /* Larger V7 Supply Logo matching Upload 1 header height */
  .menu-drawer__logo-img {
    height: 30px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  /* Bold, Thicker, Larger X Close Button at Top Right */
  .menu-drawer__close-button {
    background: transparent;
    border: none;
    color: #ffffff;
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .menu-drawer__close-button svg {
    width: 24px;
    height: 24px;
  }

  /* Navigation & Faint Divider Lines */
  .menu-drawer__navigation {
    padding: 0;
  }

  .menu-drawer__menu {
    list-style: none;
    padding-inline: 20px;
    margin: 0;
  }

  .menu-drawer__list-item--divider {
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  /* Menu Headings Font, Size, Boldness, and White Color */
  .menu-drawer__menu-item--mainlist {
    color: #ffffff !important;
    font-size: 1.6rem !important;
    font-weight: 600 !important;
    letter-spacing: -0.01em;
    padding: 16px 0 !important;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .menu-drawer__menu-item--mainlist:hover {
    color: #ffffff !important;
  }

  /* Backdrop Overlay */
  .menu-drawer__backdrop {
    position: fixed;
    top: 0;
    inset-inline-start: 0;
    width: 100vw;
    height: 100dvh;
    backdrop-filter: brightness(0.75);
    z-index: var(--layer-overlay);
    opacity: 0;
    transition: opacity 0.25s ease;

    .menu-open & {
      opacity: 1;
    }
  }
{% endstylesheet %}
